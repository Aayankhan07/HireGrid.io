# HireGrid.io Environment Configuration Template
# Copy this file to a new file named '.env' and edit the variables accordingly.

# Environment Type: development | production
# Setting this to 'production' enforces the security checks below:
#   - JWT_SECRET must be set (startup fails otherwise)
#   - the mock Google login bypass is disabled unconditionally
#   - the example admin password is rejected
ENV=development

# Security: Secret key used for cryptographically signing session tokens.
# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset outside production, a random key is generated per process and
# sessions will not survive a restart.
JWT_SECRET=

# Security: Enable the sandbox mock Google login bypass.
# This accepts an unsigned, self-asserted email address and is a complete
# authentication bypass. It is ignored entirely when ENV=production.
ALLOW_DEV_BYPASS=false

# Security: Seed credentials for the default administrator account.
# If ADMIN_PASSWORD is empty, a random password is generated and logged once
# (development), or the admin seed is skipped entirely (production).
ADMIN_EMAIL=admin@hiregrid.io
ADMIN_PASSWORD=

# Security: Login throttling (per client IP + email address).
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300

# Security: CORS Allowed Origins (comma-separated list)
# backend/app.py will load these to restrict CORS to trusted domains.
ALLOWED_ORIGINS=http://localhost:3000

# Google Accounts OAuth 2.0 client ID for frontend authentication.
# This is baked into the frontend bundle at BUILD time. For Docker, pass it as
# a build argument: docker build --build-arg NEXT_PUBLIC_GOOGLE_CLIENT_ID=<id> .
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# Backend origin used by the Next.js /api rewrite. Not needed for the Docker
# image (nginx routes /api itself) but required for split deployments.
BACKEND_URL=http://localhost:8000

# Database Connection.
# Leave unset to use a local SQLite file (backend/hiregrid.db).
# For PostgreSQL, set a full connection string:
#   postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Maximum size of a single uploaded resume, in bytes (default 15MB).
MAX_RESUME_BYTES=15728640

# Postgres connection pool ceiling.
DB_POOL_MAX=10

# ── Embedding model (advanced) ────────────────────────────────────────────────
# Carries 40% of the composite score, so this is the highest-leverage setting
# in the system — and the easiest to get wrong.
#
# Registered options (see MODEL_REGISTRY in backend/core/similarity.py), each
# with its own calibration band and query prefix:
#   all-MiniLM-L6-v2                        (default, fastest)
#   BAAI/bge-small-en-v1.5
#   BAAI/bge-base-en-v1.5
#   sentence-transformers/all-mpnet-base-v2
#
# A model with better public benchmark scores is NOT automatically better here.
# Measured on this repo's benchmark, bge-small compressed the usable score range
# (an off-domain resume scored 0.52 cosine against an unrelated JD, versus 0.10
# for MiniLM) and mis-ordered a candidate pair (Kendall tau 0.926 vs 1.000).
# Run this before changing it:
#   python accuracy_checker/compare_models.py
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Scoring calibration (advanced) ────────────────────────────────────────────
# Cosine similarity bands used to stretch raw model output onto a 0-100 scale.
# Defaults come from the active model's registry entry; set these only to
# override. They are heuristic, not fitted to labelled data.
# SEMANTIC_FLOOR=15.0
# SEMANTIC_CEILING=65.0
# SKILL_FLOOR=15.0
# SKILL_CEILING=70.0

# How much the best-matching resume section counts versus the average across
# all sections (0.0 = pure mean, 1.0 = pure max). Weighted toward max because
# recruiters look for the strongest relevant evidence rather than penalising a
# candidate for also having unrelated history.
CHUNK_MAX_WEIGHT=0.7

# Relevance floor. Candidates scoring below BOTH values are marked
# 'Auto-Rejected' (they are still recorded and visible, not discarded).
AUTO_REJECT_SKILL_SIM=10.0
AUTO_REJECT_SEMANTIC=20.0
