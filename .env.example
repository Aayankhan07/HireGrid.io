# HireGrid.io Environment Configuration Template
# Copy this file to a new file named '.env' and edit the variables accordingly.

# Environment Type (development, production, etc.)
ENV=development

# Security: Enable sandbox mock Google login bypass.
# WARNING: Set this to 'false' in production.
ALLOW_DEV_BYPASS=true

# Security: Seed credentials for default administrator account.
# WARNING: Change this password immediately in production.
ADMIN_EMAIL=admin@hiregrid.io
ADMIN_PASSWORD=password123

# Security: CORS Allowed Origins (comma-separated list)
# backend/app.py will load these to restrict CORS to trusted domains.
ALLOWED_ORIGINS=http://localhost:3000

# Security: Secret Key used for cryptographically signing session tokens.
# WARNING: Set this to a long, complex, secret string in production.
JWT_SECRET=super-secret-key-hiregrid-12345

# Google Accounts OAuth 2.0 client ID for frontend authentication
# Replace with a real Google Client ID when deploying to production.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
